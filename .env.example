# Copy to .env and edit. Never commit .env.

# Where Ollama is listening. Leave unset when using docker compose
# (it defaults to host.docker.internal). For local runs without Docker:
# OLLAMA_HOST=http://localhost:11434

LLM_MODEL=qwen2.5:7b-instruct
# Lighter fallback for laptops with 8 GB RAM:
# LLM_MODEL=qwen2.5:3b-instruct

# true = no model calls; canned answers for testing the pipeline
MOCK_LLM=false

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
CHUNKING=clause            # clause | fixed
TOP_K=8                    # chunks retrieved
EVIDENCE_K=4               # chunks given to the model
ABSTAIN_THRESHOLD=0.45     # below this similarity -> not_found (tune with eval/run_eval.py)
EXTRACT_RULES_ON_INGEST=true

# --- Student login (app/auth.py) ---
REQUIRE_LOGIN=true         # false = also accept the brief's X-Student-Id header without a password
DEMO_PASSWORD=nsut@123     # starting password for students who have not set their own
TOKEN_HOURS=8
# AUTH_SECRET=             # token signing key; if unset a random one is kept in data/.auth_secret
