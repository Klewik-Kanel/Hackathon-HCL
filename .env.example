# Copy to .env and edit. Never commit .env.

# Where Ollama is listening. Leave unset when using docker compose
# (it defaults to host.docker.internal). For local runs without Docker:
# OLLAMA_HOST=http://localhost:11434

LLM_MODEL=qwen2.5:7b-instruct
# Lighter fallback for laptops with 8 GB RAM:
# LLM_MODEL=qwen2.5:3b-instruct

# true = no model calls; canned answers for testing the pipeline
MOCK_LLM=false

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
TOP_K=8
